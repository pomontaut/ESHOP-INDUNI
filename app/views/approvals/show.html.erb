<style>
  body { background:#f6f5f3; font-family: Inter, Segoe UI, Arial, sans-serif; color:#10233e; }
  .wrap { max-width: 760px; margin: 40px auto; padding: 0 20px 60px; }
  .header { background:#0c1d34; border-radius:14px; padding:28px 32px; color:white; margin-bottom:24px; }
  .header h1 { margin:0 0 4px; font-size:22px; }
  .header p { margin:0; color:#93a2b8; font-size:14px; }
  .card { background:white; border-radius:14px; box-shadow:0 4px 18px #0b1e3512; padding:28px 32px; margin-bottom:18px; }
  .meta-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:20px; }
  .meta-item label { display:block; font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:#697386; margin-bottom:3px; }
  .meta-item span { font-size:15px; font-weight:700; }
  table { width:100%; border-collapse:collapse; }
  th { background:#0c1d34; color:white; padding:10px 12px; text-align:left; font-size:13px; }
  td { padding:10px 12px; border-bottom:1px solid #e5e7eb; font-size:14px; }
  .total-row td { background:#f1642a; color:white; font-weight:900; font-size:16px; border:none; }
  .amount { text-align:right; }
  .btn-approve { background:#176b28; border:0; color:white; padding:14px 32px; border-radius:10px; font-size:16px; font-weight:900; cursor:pointer; }
  .btn-refuse  { background:#c0392b; border:0; color:white; padding:14px 32px; border-radius:10px; font-size:16px; font-weight:900; cursor:pointer; }
  .refuse-form { display:none; margin-top:16px; }
  .refuse-form textarea { width:100%; border:1.5px solid #e5e7eb; border-radius:9px; padding:12px; font-size:14px; min-height:80px; box-sizing:border-box; }
  .refused-badge  { background:#fef2f2; border:2px solid #fca5a5; color:#b91c1c; border-radius:10px; padding:16px 20px; font-weight:700; }
  .approved-badge { background:#f0fdf4; border:2px solid #86efac; color:#166534; border-radius:10px; padding:16px 20px; font-weight:700; }
</style>

<div class="wrap">
  <div class="header">
    <h1>INDUNI E-Shop — Demande d'approbation</h1>
    <p>Commande soumise par <%= @order.user&.full_name %> (<%= @order.user&.job_function %>)</p>
  </div>

  <% if @order.approved? %>
    <div class="approved-badge">✅ Cette commande a déjà été approuvée.</div>
  <% elsif @order.refused? %>
    <div class="refused-badge">❌ Cette commande a déjà été refusée.</div>
  <% else %>

  <div class="card">
    <div class="meta-grid">
      <div class="meta-item"><label>Numéro</label><span><%= @order.number %></span></div>
      <div class="meta-item"><label>Date</label><span><%= @order.order_date&.strftime('%d.%m.%Y') %></span></div>
      <div class="meta-item"><label>Fournisseur</label><span><%= @order.supplier.name %></span></div>
      <div class="meta-item"><label>Notes</label><span><%= @order.notes %></span></div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Article</th>
          <th>Référence</th>
          <th class="amount">Qté</th>
          <th class="amount">Prix unit. CHF</th>
          <th class="amount">Total CHF</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_lines.each do |line| %>
          <tr>
            <td><%= line.product.name %></td>
            <td style="color:#697386;font-size:12px;"><%= line.product.reference %></td>
            <td class="amount"><%= line.quantity %></td>
            <td class="amount"><%= number_with_delimiter(line.unit_price.to_f.round(2)) %></td>
            <td class="amount"><%= number_with_delimiter(line.subtotal.to_f.round(2)) %></td>
          </tr>
        <% end %>
        <tr class="total-row">
          <td colspan="4">TOTAL</td>
          <td class="amount"><%= number_with_delimiter(@order.total.to_f.round(2)) %> CHF</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3 style="margin:0 0 20px;font-size:18px;">Votre décision</h3>
    <div style="display:flex;gap:16px;flex-wrap:wrap;">
      <%= form_with url: approve_approval_path(@order.approval_token), method: :post do %>
        <button type="submit" class="btn-approve"
          onclick="return confirm('Confirmer l\'approbation de la commande <%= @order.number %> ?')">
          ✅ Valider la commande
        </button>
      <% end %>

      <button type="button" class="btn-refuse" onclick="document.getElementById('refuseForm').style.display='block';this.style.display='none'">
        ❌ Refuser la commande
      </button>
    </div>

    <div id="refuseForm" class="refuse-form">
      <%= form_with url: refuse_approval_path(@order.approval_token), method: :post do |f| %>
        <label style="font-weight:700;display:block;margin-bottom:8px;">Motif du refus <span style="color:#c0392b;">*</span></label>
        <%= f.text_area :comment, placeholder: "Expliquez pourquoi vous refusez cette commande...", required: true, class: "" %>
        <div style="margin-top:12px;display:flex;gap:12px;">
          <button type="submit" class="btn-refuse">Confirmer le refus</button>
          <button type="button" onclick="document.getElementById('refuseForm').style.display='none'" style="background:none;border:1px solid #ddd;border-radius:9px;padding:12px 20px;cursor:pointer;">Annuler</button>
        </div>
      <% end %>
    </div>
  </div>

  <% end %>
</div>
