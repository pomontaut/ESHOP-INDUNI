<%
  paragraphs = @body.to_s.split(/\n{2,}/)
  before_button = paragraphs.first(3).join("\n\n")
  after_button  = paragraphs.drop(3).join("\n\n")
%>
<%= simple_format(h(before_button)) %>

<table role="presentation" style="margin:20px 0;width:100%;max-width:520px;">
  <tr>
    <td style="background:#176b28;border-radius:12px;padding:22px 20px;">
      <a href="<%= @reception_url %>" style="display:block;color:white;font-weight:900;font-size:19px;line-height:1.3;text-decoration:none;text-align:center;">✅ CLIQUER ICI POUR ACCUSER RÉCEPTION DE NOTRE COMMANDE</a>
    </td>
  </tr>
</table>

<%= simple_format(h(after_button)) %>
