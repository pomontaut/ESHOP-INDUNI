<p>Bonjour <%= @user&.first_name %>,</p>

<p>Votre commande <strong><%= @order.number %></strong> a été <strong style="color:#c0392b;">refusée</strong>.</p>

<table style="border-collapse:collapse;width:100%;max-width:400px;margin-bottom:20px;">
  <tr><td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold;">Commande</td><td style="padding:8px;border:1px solid #ddd;"><%= @order.number %></td></tr>
  <tr><td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold;">Fournisseur</td><td style="padding:8px;border:1px solid #ddd;"><%= @order.supplier.name %></td></tr>
  <tr><td style="padding:8px;border:1px solid #ddd;background:#f9f9f9;font-weight:bold;">Montant</td><td style="padding:8px;border:1px solid #ddd;"><%= number_with_delimiter(@order.total.to_i) %> CHF</td></tr>
</table>

<div style="background:#fff5f5;border:2px solid #fca5a5;border-radius:10px;padding:16px;margin-bottom:20px;">
  <strong style="color:#c0392b;">Motif du refus :</strong><br>
  <%= @order.approval_comment %>
</div>

<p>Connectez-vous à l'e-shop pour modifier votre commande, renvoyer la demande ou la supprimer.</p>

<p style="color:#666;font-size:13px;">INDUNI E-Shop</p>
