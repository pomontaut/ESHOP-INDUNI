<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">INDUNI E-Shop</h1>
      <p class="text-gray-500 mt-2">Connectez-vous avec votre adresse @induni.ch</p>
    </div>

    <div class="bg-white shadow rounded-lg p-8">
      <% if flash[:alert] %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: login_path, local: true do |f| %>
        <div class="mb-4">
          <%= f.label :email, "Adresse e-mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, placeholder: "prenom.nom@induni.ch",
              class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              autocomplete: "email", autofocus: true %>
        </div>

        <div class="mb-6">
          <%= f.label :password, "Mot de passe", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password,
              class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              autocomplete: "current-password" %>
        </div>

        <%= f.submit "Se connecter",
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
