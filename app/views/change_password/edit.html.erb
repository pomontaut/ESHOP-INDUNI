<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f6f5f3;">
  <div style="width:100%;max-width:440px;padding:0 16px;">
    <div style="text-align:center;margin-bottom:32px;">
      <div style="background:#0c1d34;display:inline-block;border-radius:12px;padding:16px 28px;margin-bottom:16px;">
        <span style="color:white;font-size:22px;font-weight:900;">INDUNI</span>
        <span style="color:#f1642a;font-size:22px;font-weight:900;"> E-Shop</span>
      </div>
      <h2 style="font-size:20px;font-weight:800;color:#10233e;margin:0 0 6px;">Choisissez votre mot de passe</h2>
      <p style="color:#697386;font-size:14px;margin:0;">Première connexion — veuillez définir un mot de passe personnel.</p>
    </div>

    <div style="background:white;border-radius:16px;box-shadow:0 8px 32px #0b1e3520;padding:32px;">
      <% if flash[:alert] %>
        <div style="background:#fff0f0;border:1px solid #f5c6c6;color:#b91c1c;border-radius:8px;padding:12px;margin-bottom:20px;font-size:14px;">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with url: change_password_path, method: :patch do |f| %>
        <div style="margin-bottom:18px;">
          <label style="display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:6px;">Nouveau mot de passe</label>
          <input type="password" name="password" required minlength="8" autofocus
            style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:11px 14px;font-size:15px;outline:none;box-sizing:border-box;">
          <p style="font-size:12px;color:#9ca3af;margin:4px 0 0;">Minimum 8 caractères</p>
        </div>

        <div style="margin-bottom:24px;">
          <label style="display:block;font-size:13px;font-weight:700;color:#374151;margin-bottom:6px;">Confirmer le mot de passe</label>
          <input type="password" name="password_confirmation" required minlength="8"
            style="width:100%;border:1px solid #d1d5db;border-radius:8px;padding:11px 14px;font-size:15px;outline:none;box-sizing:border-box;">
        </div>

        <button type="submit"
          style="width:100%;background:#f1642a;border:0;border-radius:10px;color:white;font-size:16px;font-weight:900;padding:14px;cursor:pointer;">
          Confirmer →
        </button>
      <% end %>
    </div>
  </div>
</div>
