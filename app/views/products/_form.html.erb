<%= form_with(model: product, class: "mt-3") do |form| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger">
      <% product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nom", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :reference, "Référence", class: "form-label" %>
    <%= form.text_field :reference, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :unit_price, "Prix unitaire", class: "form-label" %>
    <%= form.number_field :unit_price, step: 0.01, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :supplier_id, "Fournisseur", class: "form-label" %>
    <%= form.collection_select :supplier_id, Supplier.all, :id, :name, { prompt: "Choisir un fournisseur" }, { class: "form-select" } %>
  </div>
  <%= form.submit "Enregistrer", class: "btn btn-primary" %>
<% end %>
