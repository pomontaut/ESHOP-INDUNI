<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Produits</h1>
  <%= link_to "Nouveau produit", new_product_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Référence</th>
      <th>Nom</th>
      <th>Prix unitaire</th>
      <th>Fournisseur</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.reference %></td>
        <td><%= product.name %></td>
        <td><%= number_to_currency(product.unit_price, unit: "CHF ") %></td>
        <td><%= product.supplier.name %></td>
        <td>
          <%= link_to "Voir", product, class: "btn btn-sm btn-info" %>
          <%= link_to "Modifier", edit_product_path(product), class: "btn btn-sm btn-warning" %>
          <%= button_to "Supprimer", product, method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Êtes-vous sûr ?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
