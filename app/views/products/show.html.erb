<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= @product.name %></h1>
  <div>
    <%= link_to "Modifier", edit_product_path(@product), class: "btn btn-warning" %>
    <%= link_to "Retour", products_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <p><strong>Référence:</strong> <%= @product.reference %></p>
    <p><strong>Prix unitaire:</strong> <%= number_to_currency(@product.unit_price, unit: "CHF ") %></p>
    <p><strong>Fournisseur:</strong> <%= @product.supplier.name %></p>
  </div>
</div>
