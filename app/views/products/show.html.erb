<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-box"></i> <%= @product.name %></h1>
  <div>
    <%= link_to '<i class="bi bi-pencil"></i> Modifier'.html_safe, edit_product_path(@product), class: "btn btn-secondary" %>
    <%= link_to '<i class="bi bi-arrow-left"></i> Retour'.html_safe, products_path, class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <p><strong>Référence :</strong> <code><%= @product.reference %></code></p>
    <p><strong>Fournisseur :</strong> <%= link_to @product.supplier.name, @product.supplier %></p>
    <p><strong>Prix unitaire :</strong> <%= number_to_currency(@product.unit_price, unit: 'CHF ', separator: '.', delimiter: "'") %></p>
  </div>
</div>
