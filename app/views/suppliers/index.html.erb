<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-people"></i> Fournisseurs</h1>
  <%= link_to '<i class="bi bi-plus-circle"></i> Nouveau fournisseur'.html_safe, new_supplier_path, class: "btn btn-primary" %>
</div>

<% if @suppliers.empty? %>
  <div class="alert alert-info">Aucun fournisseur enregistré.</div>
<% else %>
  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Nom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Produits</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @suppliers.each do |supplier| %>
            <tr>
              <td><strong><%= supplier.name %></strong></td>
              <td><a href="mailto:<%= supplier.email %>"><%= supplier.email %></a></td>
              <td><%= supplier.phone %></td>
              <td><span class="badge bg-secondary"><%= supplier.products.count %></span></td>
              <td>
                <%= link_to '<i class="bi bi-eye"></i>'.html_safe, supplier, class: "btn btn-sm btn-outline-primary" %>
                <%= link_to '<i class="bi bi-pencil"></i>'.html_safe, edit_supplier_path(supplier), class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to '<i class="bi bi-trash"></i>'.html_safe, supplier, method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Supprimer ce fournisseur ?' }, class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
