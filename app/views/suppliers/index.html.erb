<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Fournisseurs</h1>
  <%= link_to "Nouveau fournisseur", new_supplier_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Nom</th>
      <th>Email</th>
      <th>Téléphone</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @suppliers.each do |supplier| %>
      <tr>
        <td><%= supplier.name %></td>
        <td><%= supplier.email %></td>
        <td><%= supplier.phone %></td>
        <td>
          <%= link_to "Voir", supplier, class: "btn btn-sm btn-info" %>
          <%= link_to "Modifier", edit_supplier_path(supplier), class: "btn btn-sm btn-warning" %>
          <%= button_to "Supprimer", supplier, method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Êtes-vous sûr ?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
