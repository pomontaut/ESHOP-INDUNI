<div class="card">
  <div class="card-body">
    <%= form_with(model: supplier, class: "needs-validation") do |form| %>
      <% if supplier.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% supplier.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :name, "Nom *", class: "form-label fw-bold" %>
        <%= form.text_field :name, class: "form-control", required: true %>
      </div>
      <div class="mb-3">
        <%= form.label :email, "Email *", class: "form-label fw-bold" %>
        <%= form.email_field :email, class: "form-control", required: true %>
      </div>
      <div class="mb-3">
        <%= form.label :phone, "Téléphone", class: "form-label fw-bold" %>
        <%= form.telephone_field :phone, class: "form-control" %>
      </div>
      <div class="mb-3">
        <%= form.label :address, "Adresse", class: "form-label fw-bold" %>
        <%= form.text_area :address, class: "form-control", rows: 3 %>
      </div>
      <div class="d-flex gap-2">
        <%= form.submit "Enregistrer", class: "btn btn-primary" %>
        <%= link_to "Annuler", suppliers_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
