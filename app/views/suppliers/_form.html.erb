<%= form_with(model: supplier, class: "mt-3") do |form| %>
  <% if supplier.errors.any? %>
    <div class="alert alert-danger">
      <% supplier.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Nom", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :email, "Email", class: "form-label" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :phone, "Téléphone", class: "form-label" %>
    <%= form.text_field :phone, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :address, "Adresse", class: "form-label" %>
    <%= form.text_area :address, class: "form-control", rows: 3 %>
  </div>
  <%= form.submit "Enregistrer", class: "btn btn-primary" %>
<% end %>
