<p class="mb-1"><%= link_to "← #{@projet.nom}", @projet %></p>
<h1 class="mb-4">🚀 Séance de lancement achat</h1>

<%= form_with model: @seance, url: projet_seance_lancement_path(@projet), method: :patch do |f| %>
  <% if @seance.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0"><% @seance.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <div class="card shadow-sm mb-3">
    <div class="card-body p-4">
      <div class="row g-3 mb-3">
        <div class="col-md-3">
          <%= f.label :date_seance, "Date", class: "form-label fw-semibold" %>
          <%= f.date_field :date_seance, class: "form-control" %>
        </div>
        <div class="col-md-5">
          <%= f.label :lieu, "Lieu", class: "form-label fw-semibold" %>
          <%= f.text_field :lieu, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= f.label :budget_cible, "Budget achat cible (CHF)", class: "form-label fw-semibold" %>
          <%= f.number_field :budget_cible, step: "0.01", min: 0, class: "form-control" %>
        </div>
      </div>
      <% { participants: "Participants", perimetre: "Périmètre des achats",
           strategie_achat: "Stratégie d'achat", risques: "Risques et points d'attention",
           decisions: "Décisions", actions: "Actions (qui / quoi / quand)" }.each do |field, label| %>
        <div class="mb-3">
          <%= f.label field, label, class: "form-label fw-semibold" %>
          <%= f.text_area field, rows: 3, class: "form-control" %>
        </div>
      <% end %>
      <div class="form-check">
        <%= f.check_box :realisee, class: "form-check-input" %>
        <%= f.label :realisee, "Séance réalisée", class: "form-check-label" %>
      </div>
    </div>
  </div>
  <%= f.submit "Enregistrer", class: "btn btn-primary" %>
  <%= link_to "Annuler", @projet, class: "btn btn-outline-secondary" %>
<% end %>
