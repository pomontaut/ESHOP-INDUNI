<%# Champ « Chantiers » : pré-rempli avec les chantiers où le prénom + nom saisis
    figurent comme technicien / contremaître / chef d'équipe ; le bouton + permet
    d'affecter n'importe quel autre chantier, sans limite. %>
<%
  selected = @user.assigned_chantiers.order(:nom).pluck(:id, :nom)
  chantier_names = @all_chantiers.to_h
%>
<div id="chantierAssignment" class="mt-3" data-matches-url="<%= chantier_matches_admin_users_path %>">
  <label class="form-label fw-semibold">Chantiers</label>
  <div class="form-text mb-2">Se remplit automatiquement avec les chantiers où ce prénom + nom figure comme technicien, contremaître ou chef d'équipe. Si le nom n'est pas trouvé, utilisez + pour affecter les chantiers souhaités.</div>
  <%= hidden_field_tag "user[assigned_chantier_ids][]", "", id: nil %>
  <div id="chantierChips" class="d-flex flex-wrap gap-2 mb-2">
    <% selected.each do |id, nom| %>
      <span class="badge text-bg-secondary d-inline-flex align-items-center gap-2 py-2 px-3" data-chantier-id="<%= id %>">
        <%= nom %>
        <input type="hidden" name="user[assigned_chantier_ids][]" value="<%= id %>">
        <button type="button" class="btn-close btn-close-white" style="font-size:9px" aria-label="Retirer" data-remove-chantier></button>
      </span>
    <% end %>
  </div>
  <div id="chantierAutoNote" class="form-text mb-2" style="display:none"></div>
  <button type="button" id="chantierAddToggle" class="btn btn-outline-primary btn-sm" title="Ajouter un chantier">＋ Ajouter un chantier</button>
  <div id="chantierAddRow" class="input-group mt-2" style="display:none">
    <input type="text" id="chantierAddInput" class="form-control" list="chantierAddList" placeholder="Rechercher un chantier par nom ou numéro…" autocomplete="off">
    <button type="button" id="chantierAddBtn" class="btn btn-primary">Ajouter</button>
  </div>
  <button type="button" id="chantierBrowseToggle" class="btn btn-outline-secondary btn-sm mt-2">📋 Parcourir la liste complète des chantiers (<%= @all_chantiers.size %>)</button>
  <div id="chantierBrowse" class="border rounded mt-2 p-2" style="display:none">
    <input type="text" id="chantierBrowseFilter" class="form-control form-control-sm mb-2" placeholder="Filtrer (nom, numéro…)" autocomplete="off">
    <div class="small text-muted mb-1"><span id="chantierBrowseCount"></span> — cochez pour affecter, décochez pour retirer.</div>
    <div id="chantierBrowseList" style="max-height:320px;overflow:auto">
      <% @all_chantiers.each do |id, nom| %>
        <label class="py-1 border-bottom" data-browse-row data-browse-text="<%= I18n.transliterate(nom.to_s).downcase %>" style="display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" class="form-check-input mt-0" data-browse-id="<%= id %>" data-browse-nom="<%= nom %>"> <span><%= nom %></span>
        </label>
      <% end %>
    </div>
  </div>
  <datalist id="chantierAddList">
    <% @all_chantiers.each do |_id, nom| %><option value="<%= nom %>"></option><% end %>
  </datalist>
  <script type="application/json" id="chantierNamesData"><%= raw(@all_chantiers.map { |id, nom| { id: id, nom: nom } }.to_json.gsub("</", "<\\/")) %></script>
</div>
<script>
(function(){
  var root=document.getElementById('chantierAssignment'); if(!root) return;
  var chips=document.getElementById('chantierChips');
  var all=JSON.parse(document.getElementById('chantierNamesData').textContent);
  var note=document.getElementById('chantierAutoNote');
  function has(id){ return !!chips.querySelector('[data-chantier-id="'+id+'"]'); }
  function addChip(id,nom,roles){
    if(has(id)) return false;
    var span=document.createElement('span');
    span.className='badge text-bg-secondary d-inline-flex align-items-center gap-2 py-2 px-3';
    span.setAttribute('data-chantier-id',id);
    span.appendChild(document.createTextNode(nom+(roles&&roles.length?' ('+roles.join(', ')+')':'')+' '));
    var input=document.createElement('input'); input.type='hidden'; input.name='user[assigned_chantier_ids][]'; input.value=id; span.appendChild(input);
    var btn=document.createElement('button'); btn.type='button'; btn.className='btn-close btn-close-white'; btn.style.fontSize='9px'; btn.setAttribute('aria-label','Retirer'); btn.setAttribute('data-remove-chantier',''); span.appendChild(btn);
    span.appendChild(btn);
    chips.appendChild(span); if(typeof syncBrowse==='function') syncBrowse(); return true;
  }
  chips.addEventListener('click',function(e){ var b=e.target.closest('[data-remove-chantier]'); if(b){ b.parentNode.remove(); syncBrowse(); } });
  // Liste complète : cases synchronisées avec les pastilles ci-dessus.
  var browse=document.getElementById('chantierBrowse'), bList=document.getElementById('chantierBrowseList');
  function syncBrowse(){
    bList.querySelectorAll('input[data-browse-id]').forEach(function(cb){ cb.checked=has(cb.getAttribute('data-browse-id')); });
    filterBrowse();
  }
  function norm(t){ return t.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase(); }
  function filterBrowse(){
    var words=norm(document.getElementById('chantierBrowseFilter').value).split(/\s+/).filter(Boolean), shown=0, sel=0;
    bList.querySelectorAll('[data-browse-row]').forEach(function(row){
      var t=row.getAttribute('data-browse-text'), ok=words.every(function(w){return t.indexOf(w)!==-1;});
      row.style.display=ok?'flex':'none'; if(ok) shown++;
    });
    sel=chips.querySelectorAll('[data-chantier-id]').length;
    document.getElementById('chantierBrowseCount').textContent=shown+' affiché(s) · '+sel+' affecté(s)';
  }
  document.getElementById('chantierBrowseToggle').addEventListener('click',function(){ browse.style.display=browse.style.display==='none'?'block':'none'; syncBrowse(); });
  document.getElementById('chantierBrowseFilter').addEventListener('input',filterBrowse);
  bList.addEventListener('change',function(e){
    var cb=e.target.closest('input[data-browse-id]'); if(!cb) return;
    var id=cb.getAttribute('data-browse-id');
    if(cb.checked) addChip(id,cb.getAttribute('data-browse-nom')); else { var chip=chips.querySelector('[data-chantier-id="'+id+'"]'); if(chip) chip.remove(); }
    filterBrowse();
  });
  document.getElementById('chantierAddToggle').addEventListener('click',function(){
    var row=document.getElementById('chantierAddRow'); row.style.display=row.style.display==='none'?'flex':'none';
    if(row.style.display==='flex') document.getElementById('chantierAddInput').focus();
  });
  function addTyped(){
    var input=document.getElementById('chantierAddInput'); var v=input.value.trim().toLowerCase(); if(!v) return;
    var found=all.find(function(c){return c.nom.toLowerCase()===v;})||all.filter(function(c){return c.nom.toLowerCase().indexOf(v)!==-1;})[0];
    if(found){ addChip(found.id,found.nom); input.value=''; input.focus(); } else { input.setCustomValidity('Chantier introuvable'); input.reportValidity(); input.setCustomValidity(''); }
  }
  document.getElementById('chantierAddBtn').addEventListener('click',addTyped);
  document.getElementById('chantierAddInput').addEventListener('keydown',function(e){ if(e.key==='Enter'){ e.preventDefault(); addTyped(); } });
  function suggest(){
    var f=document.getElementById('user_first_name'), l=document.getElementById('user_last_name'); if(!f||!l||!f.value.trim()||!l.value.trim()) return;
    fetch(root.getAttribute('data-matches-url')+'?first_name='+encodeURIComponent(f.value)+'&last_name='+encodeURIComponent(l.value),{headers:{Accept:'application/json'}})
      .then(function(r){return r.json();}).then(function(list){
        var added=0; list.forEach(function(m){ if(addChip(m.id,m.nom,m.roles)) added++; });
        note.style.display='block';
        note.textContent=list.length?(added+' chantier(s) ajouté(s) automatiquement ('+list.length+' trouvé(s) pour ce nom).'):'Aucun chantier trouvé pour ce nom : utilisez « Ajouter un chantier ».';
      }).catch(function(){});
  }
  ['user_first_name','user_last_name'].forEach(function(id){ var el=document.getElementById(id); if(el) el.addEventListener('change',suggest); });
  if(!chips.children.length) suggest();
})();
</script>
