<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Gestion des utilisateurs</h1>
    <p class="text-muted mb-0"><%= @users.count %> utilisateur(s)</p>
  </div>
  <%= link_to "＋ Nouvel utilisateur", new_admin_user_path, class: "btn btn-primary" %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body d-flex flex-wrap align-items-center gap-3">
    <div class="me-auto">
      <h2 class="h6 mb-1">🧪 Mode test (aperçu profil)</h2>
      <p class="text-muted small mb-0">
        Affiche l'e-shop avec le seul bandeau d'un profil d'exploitation, sans quitter votre compte.
        <% if preview_profile %>
          <strong>Mode test actif : <%= User::PREVIEW_PROFILES[preview_profile][:label] %>.</strong>
        <% end %>
      </p>
    </div>
    <% User::PREVIEW_PROFILES.each do |key, profile| %>
      <button type="button" class="btn btn-outline-primary btn-sm" data-preview-profile="<%= key %>">
        Tester : <%= profile[:label] %>
      </button>
    <% end %>
    <% if preview_profile %>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-preview-exit>Quitter le mode test</button>
    <% end %>
  </div>
</div>
<script>
  document.querySelectorAll('[data-preview-profile]').forEach(function (b) {
    b.addEventListener('click', function () {
      fetch('/api/preview', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ profile: b.dataset.previewProfile }) })
        .then(function (r) { if (!r.ok) throw new Error(); window.location.href = '/catalogue.html' })
        .catch(function () { alert('Impossible d\'activer le mode test.') })
    })
  })
  document.querySelectorAll('[data-preview-exit]').forEach(function (b) {
    b.addEventListener('click', function () {
      fetch('/api/preview', { method: 'DELETE' }).then(function () { window.location.reload() })
    })
  })
</script>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead style="background:#0c1d34;color:white;">
        <tr>
          <th class="py-3 ps-3">Nom complet</th>
          <th class="py-3">Fonction</th>
          <th class="py-3">Secteur</th>
          <th class="py-3">Email</th>
          <th class="py-3 text-center">Droits e-shop</th>
          <th class="py-3 text-center">Catalogues</th>
          <th class="py-3 text-center">Plafond CHF</th>
          <th class="py-3 text-center">Statut</th>
          <th class="py-3 text-center pe-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="py-3 ps-3 fw-semibold">
              <%= user.full_name %>
              <% if user == current_user %>
                <span class="badge bg-info ms-1" style="font-size:10px;">moi</span>
              <% end %>
            </td>
            <td class="py-3 text-muted small"><%= user.job_function.presence || "—" %></td>
            <td class="py-3 text-muted small"><%= user.sector.presence || "—" %></td>
            <td class="py-3 small"><%= user.email %></td>
            <td class="py-3 text-center">
              <% if user.admin? %>
                <span class="badge" style="background:#f1642a;">Tous</span>
              <% else %>
                <div class="d-flex flex-wrap gap-1 justify-content-center">
                  <% if user.can_read? %>
                    <span class="badge bg-secondary" title="Lecture">👁</span>
                  <% end %>
                  <% if user.can_create_orders? %>
                    <span class="badge bg-success" title="Création commande">＋</span>
                  <% end %>
                  <% if user.can_modify_orders? %>
                    <span class="badge bg-primary" title="Modification commande">✏</span>
                  <% end %>
                  <% if user.can_create_users? %>
                    <span class="badge bg-warning text-dark" title="Création utilisateurs">👤</span>
                  <% end %>
                  <% if user.can_import_quote? %>
                    <span class="badge bg-info text-dark" title="Importer un devis">📥</span>
                  <% end %>
                  <% if user.can_generic_order? %>
                    <span class="badge bg-dark" title="Bon de commande générique">📋</span>
                  <% end %>
                </div>
              <% end %>
            </td>
            <td class="py-3 text-center small">
              <% if user.admin? %>
                <span class="text-muted">Tous</span>
              <% else %>
                <%= user.allowed_suppliers.map { |k| User::SUPPLIERS.find { |s| s[:key] == k }&.dig(:label) }.compact.join(", ").presence || "—" %>
              <% end %>
            </td>
            <td class="py-3 text-center small">
              <% if user.order_limit.present? %>
                <%= number_with_delimiter(user.order_limit.to_i) %> CHF
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td class="py-3 text-center">
              <% if user.must_change_password? %>
                <span class="badge bg-warning text-dark">En attente</span>
              <% else %>
                <span class="badge bg-success">Actif</span>
              <% end %>
            </td>
            <td class="py-3 text-center pe-3">
              <div class="d-flex gap-1 justify-content-center flex-wrap">
                <%= link_to "✏ Modifier", edit_admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
                <% if user.must_change_password? %>
                  <%= button_to "📧 Renvoyer accès", resend_welcome_admin_user_path(user),
                      method: :post, class: "btn btn-warning btn-sm",
                      data: { turbo_confirm: "Envoyer un nouveau mot de passe temporaire à #{user.email} ?" } %>
                <% end %>
                <% unless user == current_user %>
                  <%= button_to "✕", admin_user_path(user), method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      data: { turbo_confirm: "Supprimer #{user.full_name} ?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
