<div class="row justify-content-center">
  <div class="col-md-7 col-lg-6">
    <div class="d-flex align-items-center gap-3 mb-4">
      <%= link_to admin_users_path, class: "btn btn-outline-secondary btn-sm" do %>← Retour<% end %>
      <h1 class="mb-0 fs-3">Nouvel utilisateur</h1>
    </div>

    <%= form_with model: [:admin, @user] do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size:12px;letter-spacing:.08em;">Identité</h6>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <%= f.label :first_name, "Prénom", class: "form-label fw-semibold" %>
              <%= f.text_field :first_name, class: "form-control", placeholder: "Marie", required: true, autofocus: true %>
            </div>
            <div class="col-6">
              <%= f.label :last_name, "Nom", class: "form-label fw-semibold" %>
              <%= f.text_field :last_name, class: "form-control", placeholder: "Dupont", required: true %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :job_function, "Fonction / Métier", class: "form-label fw-semibold" %>
            <%= f.text_field :job_function, class: "form-control", placeholder: "ex: Conducteur de travaux" %>
          </div>

          <hr class="my-4">
          <h6 class="text-uppercase text-muted fw-bold mb-3" style="font-size:12px;letter-spacing:.08em;">Accès</h6>

          <div class="mb-3">
            <%= f.label :email, "Adresse e-mail", class: "form-label fw-semibold" %>
            <%= f.email_field :email, class: "form-control", placeholder: "prenom.nom@induni.ch", required: true %>
            <div class="form-text">Doit être une adresse @induni.ch</div>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Mot de passe temporaire", class: "form-label fw-semibold" %>
            <%= f.password_field :password, class: "form-control", required: true, minlength: 8 %>
            <div class="form-text">L'utilisateur devra le changer à sa première connexion.</div>
          </div>

          <%= f.hidden_field :must_change_password, value: "1" %>

          <div class="form-check mb-2">
            <%= f.check_box :admin, class: "form-check-input" %>
            <%= f.label :admin, "Accès administrateur", class: "form-check-label" %>
          </div>
        </div>

        <div class="card-footer bg-transparent d-flex gap-2 p-3">
          <%= f.submit "Créer l'utilisateur", class: "btn btn-primary px-4" %>
          <%= link_to "Annuler", admin_users_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
