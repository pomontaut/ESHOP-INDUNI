<div class="row justify-content-center">
  <div class="col-md-6">
    <h1 class="mb-4">Nouvel utilisateur</h1>

    <%= form_with model: [:admin, @user], class: "needs-validation" do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :email, "Email", class: "form-label" %>
        <%= f.email_field :email, class: "form-control", placeholder: "prenom.nom@induni.ch", required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Mot de passe", class: "form-label" %>
        <%= f.password_field :password, class: "form-control", required: true, minlength: 8 %>
      </div>

      <div class="mb-3">
        <%= f.label :first_name, "Prénom", class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :last_name, "Nom", class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class="mb-3 form-check">
        <%= f.check_box :admin, class: "form-check-input" %>
        <%= f.label :admin, "Administrateur", class: "form-check-label" %>
      </div>

      <div class="d-flex gap-2">
        <%= f.submit "Créer l'utilisateur", class: "btn btn-primary" %>
        <%= link_to "Annuler", admin_users_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
