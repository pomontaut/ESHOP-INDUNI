<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <div class="d-flex align-items-center gap-3 mb-4">
      <%= link_to admin_users_path, class: "btn btn-outline-secondary btn-sm" do %>← Retour<% end %>
      <h1 class="mb-0 fs-3">Modifier — <%= @user.full_name %></h1>
    </div>

    <%= form_with model: [:admin, @user] do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# ── Identité ── %>
      <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#0c1d34;color:white;">👤 Identité</div>
        <div class="card-body p-4">
          <div class="row g-3 mb-3">
            <div class="col-6">
              <%= f.label :first_name, "Prénom", class: "form-label fw-semibold" %>
              <%= f.text_field :first_name, class: "form-control", required: true %>
            </div>
            <div class="col-6">
              <%= f.label :last_name, "Nom", class: "form-label fw-semibold" %>
              <%= f.text_field :last_name, class: "form-control", required: true %>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <%= f.label :job_function, "Fonction / Métier", class: "form-label fw-semibold" %>
              <%= f.text_field :job_function, class: "form-control" %>
            </div>
            <div class="col-6">
              <%= f.label :sector, "Secteur / Service", class: "form-label fw-semibold" %>
              <%= f.select :sector, [["— Choisir —", ""]] + User::SECTORS.map { |s| [s, s] },
                           {}, class: "form-select" %>
            </div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-6">
              <%= f.label :email, "Adresse e-mail", class: "form-label fw-semibold" %>
              <%= f.email_field :email, class: "form-control", required: true %>
            </div>
            <div class="col-6">
              <%= f.label :phone, "Téléphone mobile", class: "form-label fw-semibold" %>
              <%= f.telephone_field :phone, class: "form-control", placeholder: "+41 79 000 00 00" %>
            </div>
          </div>
          <div class="mb-0">
            <%= f.label :password, "Nouveau mot de passe", class: "form-label fw-semibold" %>
            <%= f.password_field :password, class: "form-control", minlength: 8, placeholder: "Laisser vide pour ne pas changer", autocomplete: "new-password", readonly: true, onfocus: "this.removeAttribute('readonly')" %>
            <div class="form-text">Cliquez dans le champ pour saisir un nouveau mot de passe.</div>
          </div>
        </div>
      </div>

      <%# ── Droits e-shop ── %>
      <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#0c1d34;color:white;">🔐 Droits e-shop</div>
        <div class="card-body p-3">
          <div class="row g-2">
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_read, class: "form-check-input" %>
                <%= f.label :can_read, "Lecture (consulter)", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_create_orders, class: "form-check-input" %>
                <%= f.label :can_create_orders, "Création de commande", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_modify_orders, class: "form-check-input" %>
                <%= f.label :can_modify_orders, "Modification de commande", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_create_users, class: "form-check-input" %>
                <%= f.label :can_create_users, "Création d'utilisateurs", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_import_quote, class: "form-check-input" %>
                <%= f.label :can_import_quote, "Importer un devis", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_generic_order, class: "form-check-input" %>
                <%= f.label :can_generic_order, "Bon de commande générique", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_view_dashboard, class: "form-check-input" %>
                <%= f.label :can_view_dashboard, "Dashboard", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_view_analysis, class: "form-check-input" %>
                <%= f.label :can_view_analysis, "Analyse achat", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-12 ps-4">
              <div class="row g-2">
                <div class="col-6">
                  <div class="form-check">
                    <%= f.check_box :can_view_market_indices, class: "form-check-input" %>
                    <%= f.label :can_view_market_indices, "↳ Indicateurs de marché", class: "form-check-label" %>
                  </div>
                </div>
                <div class="col-6">
                  <div class="form-check">
                    <%= f.check_box :can_view_intelligence_buying, class: "form-check-input" %>
                    <%= f.label :can_view_intelligence_buying, "↳ Intelligence Buying", class: "form-check-label" %>
                  </div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :can_view_nomenclature, class: "form-check-input" %>
                <%= f.label :can_view_nomenclature, "Nomenclature", class: "form-check-label" %>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check">
                <%= f.check_box :admin, class: "form-check-input", onchange: "document.getElementById('adminCodeBlock').style.display=this.checked?'block':'none'" %>
                <%= f.label :admin, "Administrateur (tous les droits)", class: "form-check-label text-danger fw-semibold" %>
              </div>
            </div>
          </div>
          <div id="adminCodeBlock" class="mt-3" style="display:<%= @user.admin? ? 'block' : 'none' %>">
            <label class="form-label fw-semibold text-danger">Code de confirmation administrateur</label>
            <input type="password" name="admin_confirmation_code" class="form-control" autocomplete="off">
            <div class="form-text">Requis uniquement au moment où le statut administrateur est accordé à cet utilisateur (pas si il l'a déjà) — demandez ce code au responsable de l'e-shop.</div>
          </div>
        </div>
      </div>

      <%# ── Accès catalogues ── %>
      <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#0c1d34;color:white;">📋 Accès catalogues fournisseurs</div>
        <div class="card-body p-3">
          <div class="row g-2">
            <% User::SUPPLIERS.each do |supplier| %>
              <div class="col-6">
                <div class="form-check">
                  <input type="checkbox" name="user[allowed_suppliers][]"
                         value="<%= supplier[:key] %>"
                         class="form-check-input"
                         id="supplier_<%= supplier[:key] %>"
                         <%= @user.allowed_suppliers.include?(supplier[:key]) ? 'checked' : '' %>>
                  <label class="form-check-label" for="supplier_<%= supplier[:key] %>">
                    <%= supplier[:label] %>
                  </label>
                </div>
              </div>
            <% end %>
          </div>
          <input type="hidden" name="user[allowed_suppliers][]" value="">
        </div>
      </div>

      <%# ── Accès aux chantiers ── %>
      <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:#0c1d34;color:white;">🏗 Accès aux chantiers</div>
        <div class="card-body p-4">
          <div class="mb-2">
            <%= f.label :chantier_access_scope, "Portée", class: "form-label fw-semibold" %>
            <%= f.select :chantier_access_scope,
                         [ [ "Uniquement ses propres chantiers", "own" ], [ "Tous les chantiers de son secteur", "secteur" ] ],
                         {}, class: "form-select" %>
            <div class="form-text">"Ses propres chantiers" = ceux où son e-mail est renseigné comme technicien, contremaître ou chef d'équipe. "Son secteur" se base sur le champ Secteur/Service ci-dessus et sur le Secteur réglé par chantier (Admin &gt; Chantiers). Sans effet si le compte est administrateur (accès à tous les chantiers Induni).</div>
          </div>
          <div class="alert alert-light border mb-0 py-2 px-3" style="font-size:13px">
            <strong>Accès actuel :</strong> <%= @user.chantier_access_label %>
          </div>
        </div>
      </div>

      <%# ── Plafond de commande ── %>
      <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold" style="background:#0c1d34;color:white;">💰 Plafond de commande</div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-6">
              <%= f.label :order_limit, "Montant max sans validation (CHF)", class: "form-label fw-semibold" %>
              <%= f.number_field :order_limit, class: "form-control", min: 0, step: 500 %>
              <div class="form-text">Laisser vide = pas de limite</div>
            </div>
            <div class="col-6">
              <%= f.label :approver_email, "Email approbateur N+1", class: "form-label fw-semibold" %>
              <%= f.email_field :approver_email, class: "form-control" %>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mb-5">
        <%= f.submit "Enregistrer les modifications", class: "btn btn-primary px-4" %>
        <%= link_to "Annuler", admin_users_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
