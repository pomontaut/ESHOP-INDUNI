<%= form_with model: [ :admin, chantier ] do |f| %>
  <% if chantier.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% chantier.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── Identité du chantier ── %>
  <div class="card shadow-sm mb-3">
    <div class="card-header fw-bold" style="background:#0c1d34;color:white;">🏗 Identité du chantier</div>
    <div class="card-body p-4">
      <div class="mb-3">
        <%= f.label :nom, "Nom du chantier", class: "form-label fw-semibold" %>
        <%= f.text_field :nom, class: "form-control", required: true, autofocus: true, placeholder: "ex: 2026-047 Rénovation Rue du Lac" %>
      </div>
      <div class="mb-3">
        <%= f.label :adresse, "Adresse", class: "form-label fw-semibold" %>
        <%= f.text_field :adresse, class: "form-control", placeholder: "Rue, numéro" %>
      </div>
      <div class="row g-3 mb-3">
        <div class="col-4">
          <%= f.label :npa, "NPA", class: "form-label fw-semibold" %>
          <%= f.text_field :npa, class: "form-control" %>
        </div>
        <div class="col-8">
          <%= f.label :ville, "Ville", class: "form-label fw-semibold" %>
          <%= f.text_field :ville, class: "form-control" %>
        </div>
      </div>
      <div class="mb-3">
        <%= f.label :carte_interactive, "Lien carte interactive", class: "form-label fw-semibold" %>
        <%= f.text_field :carte_interactive, class: "form-control", placeholder: "https://..." %>
      </div>
      <div class="mb-3">
        <%= f.label :contraintes_acces, "Contraintes d'accès", class: "form-label fw-semibold" %>
        <%= f.text_area :contraintes_acces, class: "form-control", rows: 2 %>
      </div>
      <div class="form-check">
        <%= f.check_box :consortium, class: "form-check-input" %>
        <%= f.label :consortium, "Chantier en consortium", class: "form-check-label" %>
      </div>
    </div>
  </div>

  <%# ── Équipe du chantier ── %>
  <div class="card shadow-sm mb-3">
    <div class="card-header fw-bold" style="background:#0c1d34;color:white;">👷 Équipe du chantier</div>
    <div class="card-body p-4">
      <p class="text-muted small">Ces adresses e-mail déterminent quels comptes voient ce chantier dans leur bon de commande.</p>

      <div class="row g-3 mb-3">
        <div class="col-4">
          <%= f.label :technicien, "Technicien", class: "form-label fw-semibold" %>
          <%= f.text_field :technicien, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :natel_technicien, "Natel", class: "form-label fw-semibold" %>
          <%= f.text_field :natel_technicien, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :email_technicien, "E-mail", class: "form-label fw-semibold" %>
          <%= f.email_field :email_technicien, class: "form-control" %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-4">
          <%= f.label :contremaitre, "Contremaître", class: "form-label fw-semibold" %>
          <%= f.text_field :contremaitre, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :natel_contremaitre, "Natel", class: "form-label fw-semibold" %>
          <%= f.text_field :natel_contremaitre, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :email_contremaitre, "E-mail", class: "form-label fw-semibold" %>
          <%= f.email_field :email_contremaitre, class: "form-control" %>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-4">
          <%= f.label :chef_equipe, "Chef d'équipe", class: "form-label fw-semibold" %>
          <%= f.text_field :chef_equipe, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :natel_chef_equipe, "Natel", class: "form-label fw-semibold" %>
          <%= f.text_field :natel_chef_equipe, class: "form-control" %>
        </div>
        <div class="col-4">
          <%= f.label :email_chef_equipe, "E-mail", class: "form-label fw-semibold" %>
          <%= f.email_field :email_chef_equipe, class: "form-control" %>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 mb-5">
    <%= f.submit chantier.new_record? ? "Créer le chantier" : "Enregistrer les modifications", class: "btn btn-primary px-4" %>
    <%= link_to "Annuler", admin_chantiers_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
