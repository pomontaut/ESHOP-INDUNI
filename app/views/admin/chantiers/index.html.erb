<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="mb-1">Gestion des chantiers</h1>
    <p class="text-muted mb-0"><%= @chantiers.count %> chantier(s)</p>
  </div>
  <%= link_to "＋ Nouveau chantier", new_admin_chantier_path, class: "btn btn-primary" %>
</div>

<%= form_with url: admin_chantiers_path, method: :get, class: "mb-3" do %>
  <div class="input-group" style="max-width:420px">
    <%= text_field_tag :q, params[:q], class: "form-control", placeholder: "Rechercher un nom, une ville, un NPA…" %>
    <button class="btn btn-outline-secondary" type="submit">Rechercher</button>
  </div>
<% end %>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead style="background:#0c1d34;color:white;">
        <tr>
          <th class="py-3 ps-3">Nom du chantier</th>
          <th class="py-3">Adresse</th>
          <th class="py-3">NPA / Ville</th>
          <th class="py-3">Contremaître</th>
          <th class="py-3">Chef d'équipe</th>
          <th class="py-3 text-center pe-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @chantiers.each do |chantier| %>
          <tr>
            <td class="py-3 ps-3 fw-semibold">
              <%= chantier.nom %>
              <% if chantier.consortium? %>
                <span class="badge bg-info ms-1" style="font-size:10px;">consortium</span>
              <% end %>
            </td>
            <td class="py-3 small text-muted"><%= chantier.adresse.presence || "—" %></td>
            <td class="py-3 small">
              <%= [ chantier.npa, chantier.ville ].select(&:present?).join(" ").presence || "—" %>
              <% if chantier.canton.present? %><br><span class="text-muted"><%= chantier.canton %></span><% end %>
              <% if chantier.secteur.present? %><br><span class="badge bg-secondary" style="font-size:10px;"><%= chantier.secteur %></span><% end %>
            </td>
            <td class="py-3 small">
              <%= chantier.contremaitre.presence || "—" %>
              <% if chantier.email_contremaitre.present? %>
                <br><span class="text-muted"><%= chantier.email_contremaitre %></span>
              <% end %>
            </td>
            <td class="py-3 small">
              <%= chantier.chef_equipe.presence || "—" %>
              <% if chantier.email_chef_equipe.present? %>
                <br><span class="text-muted"><%= chantier.email_chef_equipe %></span>
              <% end %>
            </td>
            <td class="py-3 text-center pe-3">
              <div class="d-flex gap-1 justify-content-center flex-wrap">
                <%= link_to "✏ Modifier", edit_admin_chantier_path(chantier), class: "btn btn-outline-primary btn-sm" %>
                <%= button_to "✕", admin_chantier_path(chantier), method: :delete,
                    class: "btn btn-outline-danger btn-sm",
                    data: { turbo_confirm: "Supprimer le chantier #{chantier.nom} ?" } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
