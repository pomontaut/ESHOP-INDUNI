<div style="font-family: Arial, sans-serif; padding: 20px;">
  <div style="text-align: center; margin-bottom: 30px; border-bottom: 2px solid #333; padding-bottom: 20px;">
    <h1 style="font-size: 28px; color: #333; margin: 0;">INDUNI</h1>
    <p style="color: #666; margin: 5px 0;">Bon de commande</p>
  </div>

  <div style="margin-bottom: 20px;">
    <h2 style="font-size: 18px;">Commande <%= @order.number %></h2>
    <p><strong>Date:</strong> <%= @order.order_date&.strftime('%d.%m.%Y') %></p>
    <p><strong>Statut:</strong> <%= @order.status %></p>
  </div>

  <div style="margin-bottom: 20px; background: #f9f9f9; padding: 15px; border: 1px solid #ddd;">
    <h3 style="font-size: 14px; margin-top: 0;">Fournisseur</h3>
    <p style="margin: 0;"><strong><%= @order.supplier.name %></strong></p>
    <p style="margin: 0;"><%= @order.supplier.email %></p>
    <p style="margin: 0;"><%= @order.supplier.phone %></p>
    <% if @order.supplier.address.present? %>
      <p style="margin: 0;"><%= @order.supplier.address %></p>
    <% end %>
  </div>

  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
    <thead>
      <tr style="background-color: #333; color: white;">
        <th style="padding: 10px; text-align: left; border: 1px solid #999;">Produit</th>
        <th style="padding: 10px; text-align: center; border: 1px solid #999;">Référence</th>
        <th style="padding: 10px; text-align: center; border: 1px solid #999;">Quantité</th>
        <th style="padding: 10px; text-align: right; border: 1px solid #999;">Prix unitaire</th>
        <th style="padding: 10px; text-align: right; border: 1px solid #999;">Sous-total</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_lines.includes(:product).each_with_index do |line, i| %>
        <tr style="background-color: <%= i.even? ? '#fff' : '#f5f5f5' %>;">
          <td style="padding: 8px; border: 1px solid #ddd;"><%= line.product.name %></td>
          <td style="padding: 8px; border: 1px solid #ddd; text-align: center;"><%= line.product.reference %></td>
          <td style="padding: 8px; border: 1px solid #ddd; text-align: center;"><%= line.quantity %></td>
          <td style="padding: 8px; border: 1px solid #ddd; text-align: right;"><%= number_to_currency(line.unit_price, unit: "CHF ") %></td>
          <td style="padding: 8px; border: 1px solid #ddd; text-align: right;"><%= number_to_currency(line.subtotal, unit: "CHF ") %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr style="background-color: #333; color: white;">
        <td colspan="4" style="padding: 10px; text-align: right; border: 1px solid #999; font-weight: bold;">TOTAL:</td>
        <td style="padding: 10px; text-align: right; border: 1px solid #999; font-weight: bold;"><%= number_to_currency(@order.total, unit: "CHF ") %></td>
      </tr>
    </tfoot>
  </table>

  <% if @order.notes.present? %>
    <div style="margin-bottom: 20px;">
      <h3 style="font-size: 14px;">Notes</h3>
      <p><%= @order.notes %></p>
    </div>
  <% end %>

  <div style="margin-top: 40px; text-align: center; color: #999; font-size: 11px; border-top: 1px solid #ddd; padding-top: 10px;">
    Commande générée automatiquement par le système INDUNI
  </div>
</div>
