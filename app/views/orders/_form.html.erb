<div class="card">
  <div class="card-body">
    <%= form_with(model: order) do |form| %>
      <% if order.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% order.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :supplier_id, "Fournisseur *", class: "form-label fw-bold" %>
        <%= form.collection_select :supplier_id, @suppliers, :id, :name, { prompt: "Choisir un fournisseur" }, { class: "form-select", required: true } %>
      </div>
      <div class="mb-3">
        <%= form.label :order_date, "Date de commande *", class: "form-label fw-bold" %>
        <%= form.date_field :order_date, class: "form-control", required: true %>
      </div>
      <div class="mb-3">
        <%= form.label :status, "Statut", class: "form-label fw-bold" %>
        <%= form.select :status, [['Brouillon', 'draft'], ['Envoyée', 'sent'], ['Confirmée', 'confirmed'], ['Reçue', 'received']], {}, { class: "form-select" } %>
      </div>
      <div class="mb-3">
        <%= form.label :notes, "Notes", class: "form-label fw-bold" %>
        <%= form.text_area :notes, class: "form-control", rows: 3 %>
      </div>
      <div class="d-flex gap-2">
        <%= form.submit "Enregistrer", class: "btn btn-primary" %>
        <%= link_to "Annuler", orders_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</div>
