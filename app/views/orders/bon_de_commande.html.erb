<%
  logo_path = Rails.root.join('app/assets/images/induni_logo.png')
  logo_b64  = Base64.strict_encode64(File.binread(logo_path))
  notes     = @order.notes.to_s
  chantier_match = notes.match(/Chantier:\s*([^|]+)/)
  delai_match    = notes.match(/Délai[^:]*:\s*(.+)/)
  chantier_val   = chantier_match ? chantier_match[1].strip : '—'
  delai_val      = delai_match    ? delai_match[1].strip    : '—'
  fmt = ->(n) { "#{'%.2f' % n.to_f}".sub('.', "'") rescue n.to_s }
%><!DOCTYPE html>
<html><head><meta charset="utf-8"><style>
@page{size:A4;margin:14mm 15mm 18mm 15mm}
*{box-sizing:border-box}
body{font-family:Arial,sans-serif;font-size:10pt;color:#111;margin:0}
.logo{width:120px;margin-bottom:6px}
.title-box{text-align:center;border:1.5px solid #111;padding:7px 0;margin:8px 0 12px}
.title-box h1{font-size:14pt;font-weight:bold;margin:0 0 2px}
.title-box p{font-size:10pt;margin:0}
.hgrid{display:grid;grid-template-columns:1fr 1fr;border:1.5px solid #111;margin-bottom:14px}
.hcol{padding:8px 10px}
.hcol:first-child{border-right:1.5px solid #111}
.htitle{background:#003087;color:white;font-weight:bold;font-size:10pt;text-align:center;padding:4px;margin:-8px -10px 7px;letter-spacing:.04em}
.cname{font-weight:bold;font-size:11pt;text-align:center;margin-bottom:5px}
.ir{margin:2px 0;font-size:9.5pt;line-height:1.35}
.il{font-weight:bold}
table{width:100%;border-collapse:collapse;margin-bottom:8px}
th{border-bottom:2px solid #111;padding:5px 4px;font-size:9pt;text-align:left;white-space:nowrap}
th:not(:first-child){text-align:right}
td{padding:4px;font-size:9pt;vertical-align:top;border-bottom:1px solid #ddd}
td:not(:first-child){text-align:right}
.tr-total td{border-top:2px solid #111;border-bottom:none;font-weight:bold;font-size:11pt;padding-top:7px}
.infos{margin-top:12px}
.infos h3{font-size:11pt;font-weight:bold;margin:0 0 5px}
.ig{display:grid;grid-template-columns:150px 1fr;gap:2px 8px;font-size:9.5pt}
.factaddr{margin-top:10px;font-size:9.5pt;line-height:1.4}
.sigrow{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:28px}
.sigbox{border-top:1px solid #111;padding-top:3px;font-size:9pt}
</style></head><body>

<img src="data:image/png;base64,<%= logo_b64 %>" class="logo" alt="INDUNI">

<div class="title-box">
  <h1>BON DE COMMANDE N° <%= @order.number %></h1>
  <p>Du <%= l(@order.order_date, format: '%d/%m/%Y') if @order.order_date %></p>
</div>

<div class="hgrid">
  <div class="hcol">
    <div class="htitle">CLIENT</div>
    <div class="cname">INDUNI &amp; CIE SA</div>
    <div class="ir"><span class="il">Contact :</span> Pierre-Olivier MONTAUT</div>
    <div class="ir"><span class="il">Chantier :</span> <%= chantier_val %></div>
    <div class="ir"><span class="il">Délai livraison :</span> <%= delai_val %></div>
    <div class="ir"><span class="il">Adresse de livraison :</span></div>
    <div class="ir" style="padding-left:10px">INDUNI &amp; Cie SA<br>Avenue des Grandes-Communes 6<br>1213 Petit-Lancy</div>
  </div>
  <div class="hcol">
    <div class="htitle">FOURNISSEUR</div>
    <div class="cname"><%= @order.supplier.name.upcase %></div>
    <% if @order.supplier.email.present? %>
    <div class="ir"><span class="il">Mail :</span> <%= @order.supplier.email %></div>
    <% end %>
    <% if @order.supplier.phone.present? %>
    <div class="ir"><span class="il">Tél :</span> <%= @order.supplier.phone %></div>
    <% end %>
    <% if @order.supplier.address.present? %>
    <div class="ir"><span class="il">Adresse :</span></div>
    <div class="ir" style="padding-left:10px"><%= @order.supplier.address.gsub("\n","<br>").html_safe %></div>
    <% end %>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th style="width:38%">Désignation</th>
      <th style="width:12%">Date livr.</th>
      <th style="width:7%">Qté</th>
      <th style="width:8%">Unité</th>
      <th style="width:13%">Réf. article</th>
      <th style="width:10%">Prix unit.</th>
      <th style="width:12%">Montant</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_lines.includes(:product).each do |line| %>
    <tr>
      <td><strong><%= line.product.name %></strong></td>
      <td><%= delai_val %></td>
      <td style="text-align:right"><%= '%.2f' % line.quantity %></td>
      <td>PCE</td>
      <td><%= line.product.reference %></td>
      <td>CHF <%= fmt.call(line.unit_price) %></td>
      <td><strong>CHF <%= fmt.call(line.unit_price.to_f * line.quantity) %></strong></td>
    </tr>
    <% end %>
    <tr class="tr-total">
      <td colspan="5">Montant total commande H.T.</td>
      <td>CHF</td>
      <td>CHF <%= fmt.call(@order.total) %></td>
    </tr>
  </tbody>
</table>

<div class="infos">
  <h3>Informations complémentaires sur le chantier</h3>
  <div class="ig">
    <span>Contremaître :</span><span>—</span>
    <span>Technicien :</span><span>Pierre-Olivier Montaut — pomontaut@induni.ch</span>
  </div>
</div>

<div class="factaddr">
  <strong>Adresse de facturation :</strong><br>
  INDUNI &amp; Cie SA<br>
  Avenue des Grandes-Communes 6<br>
  1213 Petit-Lancy<br>
  facturation@induni.ch
</div>

<div class="sigrow">
  <div class="sigbox">Pierre-Olivier Montaut</div>
  <div class="sigbox">&nbsp;</div>
</div>

</body></html>
