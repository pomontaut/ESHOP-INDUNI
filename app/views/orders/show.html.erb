<%# ── Status banner ── %>
<% if @order.approval_status == 'pending_approval' %>
  <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
    ⏳ <strong>En attente d'approbation</strong> — Une demande a été envoyée à <strong><%= @order.approver_email %></strong>.
  </div>
<% elsif @order.approval_status == 'refused' %>
  <div class="alert alert-danger mb-4">
    ❌ <strong>Commande refusée</strong>
    <% if @order.approval_comment.present? %>
      — Motif : <em><%= @order.approval_comment %></em>
    <% end %>
  </div>
<% elsif @order.approval_status == 'approved' && @order.status != 'sent' %>
  <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
    ✅ <strong>Commande approuvée</strong> — Vous pouvez maintenant l'envoyer au fournisseur.
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
  <h1 class="mb-0">Commande <%= @order.number %></h1>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "← Retour", orders_path, class: "btn btn-outline-secondary" %>

    <%# Envoyer au fournisseur — uniquement si approuvé (ou pas de workflow) %>
    <% if (@order.approval_status == 'approved' || @order.approval_status.blank?) && @order.status != 'sent' %>
      <%= link_to "⬇ Télécharger .eml", download_eml_order_path(@order), class: "btn btn-outline-primary" %>
      <%= button_to "📧 Envoyer au fournisseur", send_to_supplier_order_path(@order),
          method: :post, class: "btn btn-success",
          data: { turbo_confirm: "Envoyer la commande #{@order.number} à #{@order.supplier.name} ?" } %>
    <% end %>

    <%# Actions sur commandes refusées uniquement %>
    <% if @order.refused? %>
      <%= link_to "✏ Modifier la commande", edit_order_path(@order), class: "btn btn-warning" %>
      <%= button_to "🔄 Renvoyer au N+1", resubmit_approval_order_path(@order),
          method: :post, class: "btn btn-primary",
          data: { turbo_confirm: "Renvoyer la demande d'approbation à #{@order.approver_email} ?" } %>
      <%= button_to "🗑 Supprimer", order_path(@order),
          method: :delete, class: "btn btn-outline-danger",
          data: { turbo_confirm: "Supprimer définitivement la commande #{@order.number} ?" } %>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header" style="background:#0c1d34;color:white;">Détails</div>
      <div class="card-body">
        <p class="mb-1"><strong>Numéro :</strong> <%= @order.number %></p>
        <p class="mb-1"><strong>Date :</strong> <%= @order.order_date&.strftime('%d.%m.%Y') %></p>
        <p class="mb-1"><strong>Statut :</strong>
          <% badge = case @order.approval_status
             when 'pending_approval' then ['bg-warning text-dark', '⏳ En attente']
             when 'approved'         then ['bg-success',           '✅ Approuvée']
             when 'refused'          then ['bg-danger',            '❌ Refusée']
             else                        [@order.status == 'sent' ? 'bg-success' : 'bg-secondary', @order.status]
             end %>
          <span class="badge <%= badge[0] %>"><%= badge[1] %></span>
        </p>
        <% if @order.notes.present? %>
          <p class="mb-0"><strong>Notes :</strong> <%= @order.notes %></p>
        <% end %>
        <% if @order.user.present? %>
          <p class="mb-0 mt-1"><strong>Rédacteur :</strong> <%= @order.user.full_name %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-header" style="background:#0c1d34;color:white;">Fournisseur</div>
      <div class="card-body">
        <p class="mb-1"><strong>Nom :</strong> <%= @order.supplier.name %></p>
        <p class="mb-1"><strong>Email :</strong> <%= @order.supplier.email %></p>
        <% if @order.supplier.phone.present? %>
          <p class="mb-0"><strong>Tél :</strong> <%= @order.supplier.phone %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header" style="background:#0c1d34;color:white;">Articles commandés</div>
  <table class="table table-hover mb-0">
    <thead>
      <tr>
        <th class="ps-3">Article</th>
        <th>Référence</th>
        <th class="text-end">Qté</th>
        <th class="text-end">Prix unit. CHF</th>
        <th class="text-end pe-3">Total CHF</th>
      </tr>
    </thead>
    <tbody>
      <% @order.order_lines.includes(:product).each do |line| %>
        <tr>
          <td class="ps-3"><%= line.product.name %></td>
          <td class="text-muted small"><%= line.product.reference %></td>
          <td class="text-end"><%= line.quantity %></td>
          <td class="text-end"><%= number_with_delimiter(line.unit_price.to_f.round(2)) %></td>
          <td class="text-end pe-3 fw-semibold"><%= number_with_delimiter(line.subtotal.to_f.round(2)) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr style="background:#f1642a;color:white;">
        <td colspan="4" class="text-end fw-bold ps-3">TOTAL</td>
        <td class="text-end fw-bold pe-3"><%= number_with_delimiter(@order.total.to_f.round(2)) %> CHF</td>
      </tr>
    </tfoot>
  </table>
</div>
