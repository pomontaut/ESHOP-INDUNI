<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Commande <%= @order.number %></h1>
  <div>
    <%= link_to "Modifier", edit_order_path(@order), class: "btn btn-warning" %>
    <%= link_to "Retour", orders_path, class: "btn btn-secondary" %>
    <%= link_to "⬇ Télécharger .eml", download_eml_order_path(@order), class: "btn btn-outline-primary" %>
    <% if @order.status == 'draft' && @order.supplier.email.present? %>
      <%= button_to "Envoyer au fournisseur", send_to_supplier_order_path(@order), method: :post, class: "btn btn-success", data: { confirm: "Envoyer la commande par email ?" } %>
    <% end %>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Détails de la commande</div>
      <div class="card-body">
        <p><strong>Numéro:</strong> <%= @order.number %></p>
        <p><strong>Date:</strong> <%= @order.order_date&.strftime('%d.%m.%Y') %></p>
        <p><strong>Statut:</strong> <span class="badge <%= @order.status == 'sent' ? 'bg-success' : 'bg-secondary' %>"><%= @order.status %></span></p>
        <% if @order.notes.present? %>
          <p><strong>Notes:</strong> <%= @order.notes %></p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">Fournisseur</div>
      <div class="card-body">
        <p><strong>Nom:</strong> <%= @order.supplier.name %></p>
        <p><strong>Email:</strong> <%= @order.supplier.email %></p>
        <p><strong>Téléphone:</strong> <%= @order.supplier.phone %></p>
      </div>
    </div>
  </div>
</div>

<h2>Lignes de commande</h2>
<table class="table table-striped">
  <thead>
    <tr>
      <th>Produit</th>
      <th>Quantité</th>
      <th>Prix unitaire</th>
      <th>Sous-total</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_lines.includes(:product).each do |line| %>
      <tr>
        <td><%= line.product.name %></td>
        <td><%= line.quantity %></td>
        <td><%= number_to_currency(line.unit_price, unit: "CHF ") %></td>
        <td><%= number_to_currency(line.subtotal, unit: "CHF ") %></td>
        <td>
          <%= button_to "Supprimer", order_order_line_path(@order, line), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Supprimer cette ligne ?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3" class="text-end fw-bold">Total:</td>
      <td colspan="2" class="fw-bold"><%= number_to_currency(@order.total, unit: "CHF ") %></td>
    </tr>
  </tfoot>
</table>

<% if @order.status == 'draft' %>
  <div class="card mt-4">
    <div class="card-header">Ajouter une ligne</div>
    <div class="card-body">
      <%= form_with(model: [@order, @order_line]) do |form| %>
        <div class="row g-3">
          <div class="col-md-4">
            <%= form.label :product_id, "Produit", class: "form-label" %>
            <%= form.collection_select :product_id, @products, :id, :name, { prompt: "Choisir un produit" }, { class: "form-select", id: "product_select" } %>
          </div>
          <div class="col-md-3">
            <%= form.label :quantity, "Quantité", class: "form-label" %>
            <%= form.number_field :quantity, class: "form-control", min: 1, value: 1 %>
          </div>
          <div class="col-md-3">
            <%= form.label :unit_price, "Prix unitaire", class: "form-label" %>
            <%= form.number_field :unit_price, step: 0.01, class: "form-control", id: "unit_price_field" %>
          </div>
          <div class="col-md-2 d-flex align-items-end">
            <%= form.submit "Ajouter", class: "btn btn-primary w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
