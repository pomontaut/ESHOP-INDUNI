<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Commandes</h1>
  <%= link_to "Nouvelle commande", new_order_path, class: "btn btn-primary" %>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Numéro</th>
      <th>Date</th>
      <th>Fournisseur</th>
      <th>Statut</th>
      <th>Total</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.number %></td>
        <td><%= order.order_date&.strftime('%d.%m.%Y') %></td>
        <td><%= order.supplier.name %></td>
        <td>
          <span class="badge <%= order.status == 'sent' ? 'bg-success' : 'bg-secondary' %>">
            <%= order.status %>
          </span>
        </td>
        <td><%= number_to_currency(order.total, unit: "CHF ") %></td>
        <td>
          <%= link_to "Voir", order, class: "btn btn-sm btn-info" %>
          <%= link_to "Modifier", edit_order_path(order), class: "btn btn-sm btn-warning" %>
          <%= button_to "Supprimer", order, method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Êtes-vous sûr ?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
