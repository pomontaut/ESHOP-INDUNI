<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-cart3"></i> Commandes</h1>
  <%= link_to '<i class="bi bi-plus-circle"></i> Nouvelle commande'.html_safe, new_order_path, class: "btn btn-primary" %>
</div>

<% if @orders.empty? %>
  <div class="alert alert-info">Aucune commande enregistrée.</div>
<% else %>
  <div class="card">
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-dark">
          <tr>
            <th>Numéro</th>
            <th>Fournisseur</th>
            <th>Date</th>
            <th>Statut</th>
            <th>Total</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td><strong><%= order.number %></strong></td>
              <td><%= order.supplier.name %></td>
              <td><%= l(order.order_date, format: :short) if order.order_date %></td>
              <td>
                <% badge_class = { 'draft' => 'bg-warning text-dark', 'sent' => 'bg-primary', 'confirmed' => 'bg-success', 'received' => 'bg-secondary' }[order.status] %>
                <% label = { 'draft' => 'Brouillon', 'sent' => 'Envoyée', 'confirmed' => 'Confirmée', 'received' => 'Reçue' }[order.status] %>
                <span class="badge <%= badge_class %>"><%= label %></span>
              </td>
              <td><%= number_to_currency(order.total, unit: 'CHF ', separator: '.', delimiter: "'") %></td>
              <td>
                <%= link_to '<i class="bi bi-eye"></i>'.html_safe, order, class: "btn btn-sm btn-outline-primary" %>
                <%= link_to '<i class="bi bi-pencil"></i>'.html_safe, edit_order_path(order), class: "btn btn-sm btn-outline-secondary" %>
                <%= link_to '<i class="bi bi-trash"></i>'.html_safe, order, data: { turbo_method: :delete, turbo_confirm: 'Supprimer cette commande ?' }, class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
