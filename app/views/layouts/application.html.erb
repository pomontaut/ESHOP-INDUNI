<!DOCTYPE html>
<html>
  <head>
    <title>Eshop Induni</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "bootstrap.min", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">INDUNI Eshop</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to "Fournisseurs", suppliers_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Produits", products_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Commandes", orders_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Bon de commande", "/bon_de_commande.html", class: "nav-link", target: "_blank" %>
            </li>
            <li class="nav-item">
              <%= link_to "Chantiers", chantiers_path, class: "nav-link" %>
            </li>
            <% if current_user&.admin? %>
              <li class="nav-item">
                <%= link_to "Admin", admin_users_path, class: "nav-link" %>
              </li>
            <% end %>
          </ul>
          <ul class="navbar-nav ms-auto">
            <% if current_user %>
              <li class="nav-item">
                <span class="nav-link text-light opacity-75"><%= current_user.email %></span>
              </li>
              <li class="nav-item">
                <%= button_to "Déconnexion", logout_path, method: :delete, class: "btn btn-outline-light btn-sm my-auto ms-2" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </div>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </body>
</html>
